# Databasen (Supabase-projektet Balaanso). Utan dem kör lokal dev en in-memory-demo
# (nollställs vid omstart); i produktion kastar vakten i src/lib/store/index.ts
# i stället för att tyst bli RAM-demo (opt-in: BLANSO_DEMO=1).
# SUPABASE_URL="https://<projekt-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# Valfritt: värdpanelens kod (standard "blanso" om osatt). Sätt egen i produktion.
# BLANSO_HOST_PASSCODE="något-hemligt"

# Rekommenderat i produktion: skyddar /api/keepalive (Vercel Cron skickar den).
# CRON_SECRET="lång-slumpsträng"
