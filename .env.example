# Kopiera till .env innan du kör appen/prisma.
# Blanso använder Postgres (Supabase). Både lokalt och i produktion pekar dessa
# mot ditt Supabase-projekt (Settings → Database → Connection string).

# Poolad anslutning (Transaction, port 6543) — appen använder denna.
DATABASE_URL="postgresql://postgres.<ref>:<lösenord>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direkt anslutning (port 5432) — används av prisma migrate.
DIRECT_URL="postgresql://postgres.<ref>:<lösenord>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Valfritt: värdpanelens kod (standard "blanso" om osatt).
# BLANSO_HOST_PASSCODE="något-hemligt"
