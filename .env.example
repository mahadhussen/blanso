# Kopiera till .env innan du kör prisma/appen.

# Lokal utveckling: fil-SQLite. Detta räcker för att köra allt lokalt.
DATABASE_URL="file:./dev.db"

# Produktion (Vercel + Turso): sätt dessa i Vercels miljövariabler, INTE här.
# När TURSO_DATABASE_URL finns använder appen Turso i stället för filen ovan.
# TURSO_DATABASE_URL="libsql://<din-db>.turso.io"
# TURSO_AUTH_TOKEN="<token från: turso db tokens create <db>>"

# Valfritt: värdpanelens kod (standard "blanso" om osatt).
# BLANSO_HOST_PASSCODE="något-hemligt"
